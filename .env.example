# DexMedix environment variables.
# Every value below is OPTIONAL — the site builds and runs with NO .env at all.
# Copy to .env for local development:  cp .env.example .env

# --- Email (optional; skipped with a logged warning when unset) ---
# Submissions are delivered to NOTIFY_EMAIL; nothing is stored in a database.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DexMedix <no-reply@dexmedix.com>"
NOTIFY_EMAIL=paulmichaelomega@gmail.com

# --- Admin ---
ADMIN_PASSWORD=
# Optional: overrides ADMIN_PASSWORD for signing the admin session cookie.
SESSION_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_NAME=DexMedix
NEXT_PUBLIC_SITE_URL=http://localhost:3000
